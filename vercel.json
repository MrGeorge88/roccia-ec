{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "heladosroccia.com" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.heladosroccia.com" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "momentosroccia.com" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.momentosroccia.com" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "roccia.com.ec" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://roccia.ec/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.roccia.com.ec" }]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
